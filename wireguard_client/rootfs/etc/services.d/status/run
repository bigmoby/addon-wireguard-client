#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant Community Add-on: WireGuard Client
# Shows the current WireGuard status:
#   - info: once, shortly after startup
#   - debug/trace: periodically
# The service never exits, otherwise s6 would restart it in a loop.
# ==============================================================================
declare status_interval=30

sleep "${status_interval}"

if [[ "${__BASHIO_LOG_LEVEL}" -ge "${__BASHIO_LOG_LEVEL_INFO}" ]]; then
    bashio::log.info "Current WireGuard Client status:"
    wg show
fi

if [[ "${__BASHIO_LOG_LEVEL}" -lt "${__BASHIO_LOG_LEVEL_DEBUG}" ]]; then
    exec sleep infinity
fi

while true; do
    sleep "${status_interval}"
    bashio::log.debug "Current WireGuard Client status:"
    wg show
done
